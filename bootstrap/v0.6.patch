diff --git a/arm64/tests/test_qemu_legacy.py b/arm64/tests/test_qemu_legacy.py
new file mode 100644
index 0000000..1ee404f
--- /dev/null
+++ b/arm64/tests/test_qemu_legacy.py
@@ -0,0 +1,104 @@
+#!/usr/bin/env python3
+"""QEMU TCG smoke tests: native ARM64 stage2 from active MBR/FAT32.
+
+This tests NO version of Windows, PE loader or legacy x86 boot sector.
+"""
+import os
+import signal
+import subprocess
+import sys
+import time
+import tempfile
+from pathlib import Path
+
+ARM = Path(__file__).resolve().parents[1]
+QEMU = os.environ.get('QEMU', 'qemu-system-aarch64')
+STAGE = ARM / 'out/legacy-stage.bin'
+PE_STAGE = ARM / 'out/legacy-pe-stage.exe'
+SUCCESS = 'NATIVE AARCH64 MBR FAT32 STAGE2 OK (not Windows)'
+PROBE = '[legacy] active MBR FAT32 ARM64.BIN/ARM64.EXE candidate'
+ROM_DIR = os.environ.get('QEMU_ROM_DIR')
+BASE = [QEMU] + (['-L', ROM_DIR] if ROM_DIR else []) + ['-machine', 'virt', '-cpu', 'cortex-a57', '-m', '256M',
+        '-smp', '1', '-display', 'none', '-serial', 'stdio', '-monitor', 'none',
+        '-bios', str(ARM / 'out/seabios-arm64.bin')]
+
+
+def run_case(mode, flags, expected, forbidden, pe=False):
+    with tempfile.TemporaryDirectory() as temp:
+        img = Path(temp) / 'legacy.img'
+        subprocess.run([sys.executable, str(ARM / 'tools/create_legacy_mbr_disk.py'),
+                        str(PE_STAGE if pe else STAGE), str(img),
+                        *(['--pe'] if pe else []), *flags], check=True)
+        modern = ['-global', 'virtio-mmio.force-legacy=false'] if mode == 'v2' else []
+        args = BASE + modern + [
+            '-drive', f'if=none,format=raw,readonly=on,file={img},id=vd0',
+            '-device', 'virtio-blk-device,drive=vd0']
+        logpath = Path(temp) / 'serial.log'
+        with logpath.open('wb') as logfile:
+            p = subprocess.Popen(args, stdout=logfile, stderr=subprocess.STDOUT,
+                                 start_new_session=True)
+            try:
+                until = time.monotonic() + 5
+                while time.monotonic() < until:
+                    log = logpath.read_text(errors='replace')
+                    if SUCCESS in log or '[arm64] halt (WFE)' in log:
+                        break
+                    if p.poll() is not None:
+                        break
+                    time.sleep(0.04)
+            finally:
+                if p.poll() is None:
+                    os.killpg(p.pid, signal.SIGKILL)
+                p.wait(timeout=3)
+        log = logpath.read_text(errors='replace')
+        missing = [phrase for phrase in expected if phrase not in log]
+        unwanted = [phrase for phrase in forbidden if phrase in log]
+        if missing or unwanted:
+            raise AssertionError(f'{mode} {flags}: missing={missing}, forbidden={unwanted}\n{log}')
+
+
+def main():
+    cases = [
+        ('fragmented-stage2', [], (PROBE, SUCCESS), ('STAGE2 FAILED',)),
+        ('inactive-mbr', ['--inactive'], ('[disk] MBR signature 55AA',), (PROBE, SUCCESS)),
+        ('bad-mbr-signature', ['--bad-mbr'], ('[disk] LBA 0 read OK',), (PROBE, SUCCESS)),
+        ('bad-bpb', ['--bad-bpb'], ('[disk] LBA 0 read OK',), (PROBE, SUCCESS)),
+        ('bad-stage2-magic', ['--bad-magic'], (PROBE, 'PE32+ ARM64 image rejected'), (SUCCESS,)),
+        ('bad-checksum', ['--bad-checksum'], (PROBE, 'stage2 checksum/length rejected'), (SUCCESS,)),
+        ('broken-fat-chain', ['--bad-chain'], (PROBE, '[boot] invalid or not supported'), (SUCCESS,)),
+        ('premature-eoc', ['--short-cluster'], (PROBE, '[boot] invalid or not supported'), (SUCCESS,)),
+    ]
+    completed = 0
+    for mode in ('v1', 'v2'):
+        for name, flags, expected, forbidden in cases:
+            run_case(mode, flags, expected, forbidden)
+            completed += 1
+            print(f'PASS: {mode} {name}', flush=True)
+    pe_cases = [
+        ('native-pe32-stage2', [],
+         ('[legacy] native PE32+ ARM64 stage2 -> handoff (no EFI)',
+          'NATIVE ARM64 PE32+ STAGE2 OK (not Windows)'),
+         ('PE32+ ARM64 image rejected',)),
+        ('reject-efi-subsystem', ['--bad-pe-subsystem'],
+         ('PE subsystem is not native ARM64', 'PE32+ ARM64 image rejected'),
+         ('NATIVE ARM64 PE32+ STAGE2 OK',)),
+        ('reject-x64-machine', ['--bad-pe-machine'],
+         ('PE32+ ARM64 image rejected',), ('NATIVE ARM64 PE32+ STAGE2 OK',)),
+        ('reject-wrong-image-base', ['--bad-pe-base'],
+         ('PE32+ ARM64 image rejected',), ('NATIVE ARM64 PE32+ STAGE2 OK',)),
+        ('reject-out-of-bounds-entry', ['--bad-pe-entry'],
+         ('PE32+ ARM64 image rejected',), ('NATIVE ARM64 PE32+ STAGE2 OK',)),
+        ('reject-import-table', ['--bad-pe-import'],
+         ('PE32+ ARM64 image rejected',), ('NATIVE ARM64 PE32+ STAGE2 OK',)),
+        ('reject-truncated-section', ['--bad-pe-section'],
+         ('PE32+ ARM64 image rejected',), ('NATIVE ARM64 PE32+ STAGE2 OK',)),
+    ]
+    for mode in ('v1', 'v2'):
+        for name, flags, expected, forbidden in pe_cases:
+            run_case(mode, flags, expected, forbidden, pe=True)
+            completed += 1
+            print(f'PASS: {mode} {name}', flush=True)
+    print(f'Passed {completed}/{(len(cases) + len(pe_cases)) * 2} legacy MBR/FAT32 QEMU scenarios')
+
+if __name__ == '__main__':
+    main()
diff --git a/arm64/tools/create_legacy_mbr_disk.py b/arm64/tools/create_legacy_mbr_disk.py
new file mode 100644
index 0000000..c7e4076
--- /dev/null
+++ b/arm64/tools/create_legacy_mbr_disk.py
@@ -0,0 +1,123 @@
+#!/usr/bin/env python3
+"""Create a sparse FAT32 active-MBR image with a native AArch64 stage2.
+
+Diagnostic format is custom (SBARMLE1), not Windows and not an x86 VBR.
+Only used for reproducible QEMU firmware smoke tests.
+"""
+import argparse
+import struct
+from pathlib import Path
+
+p = argparse.ArgumentParser()
+p.add_argument('stage', type=Path)
+p.add_argument('output', type=Path)
+p.add_argument('--inactive', action='store_true')
+p.add_argument('--pe', action='store_true', help='raw synthetic PE32+ file')
+p.add_argument('--bad-pe-subsystem', action='store_true')
+p.add_argument('--bad-pe-machine', action='store_true')
+p.add_argument('--bad-pe-base', action='store_true')
+p.add_argument('--bad-pe-entry', action='store_true')
+p.add_argument('--bad-pe-import', action='store_true')
+p.add_argument('--bad-pe-section', action='store_true')
+p.add_argument('--bad-mbr', action='store_true')
+p.add_argument('--bad-bpb', action='store_true')
+p.add_argument('--bad-checksum', action='store_true')
+p.add_argument('--bad-chain', action='store_true')
+p.add_argument('--bad-magic', action='store_true')
+p.add_argument('--short-cluster', action='store_true')
+a = p.parse_args()
+
+stage = a.stage.read_bytes()
+assert len(stage) == 1024 if not a.pe else len(stage) >= 512
+fnv = 2166136261
+for b in stage:
+    fnv = ((fnv ^ b) * 16777619) & 0xffffffff
+if a.bad_checksum: fnv ^= 0x1
+header = bytearray(64)
+header[:8] = b'SBARMLE1' if not a.bad_magic else b'MZARMLE1'
+struct.pack_into('<II', header, 8, len(stage), fnv)
+filedata = bytearray(stage if a.pe else header + stage)
+if a.pe:
+    peoffset = struct.unpack_from('<I', filedata, 0x3c)[0]
+    opt = peoffset + 24
+    if a.bad_pe_subsystem:
+        struct.pack_into('<H', filedata, opt + 68, 10)
+    if a.bad_pe_machine:
+        struct.pack_into('<H', filedata, peoffset + 4, 0x8664)
+    if a.bad_pe_base:
+        struct.pack_into('<Q', filedata, opt + 24, 0x50000000)
+    if a.bad_pe_entry:
+        struct.pack_into('<I', filedata, opt + 16, 0x100000)
+    if a.bad_pe_import:
+        struct.pack_into('<II', filedata, opt + 112 + 8, 0x1000, 16)
+    if a.bad_pe_section:
+        first_section = opt + struct.unpack_from('<H', filedata, peoffset + 20)[0]
+        struct.pack_into('<I', filedata, first_section + 20, len(filedata) + 0x200)
+assert len(filedata) <= 1536
+
+START = 2048
+TOTAL = 80000
+FATSECTORS = 650
+RESERVED = 32
+DATA = RESERVED + FATSECTORS
+ROOT = 2
+BOOT = 3
+FILE_CHAIN = [4, 6, 9]
+
+
+def wr(f, lba, data):
+    assert len(data) == 512
+    f.seek(lba * 512)
+    f.write(data)
+
+
+def dirent(name, attr, clus, length):
+    e = bytearray(32)
+    e[:11] = name
+    e[11] = attr
+    struct.pack_into('<H', e, 20, clus >> 16)
+    struct.pack_into('<H', e, 26, clus & 0xffff)
+    struct.pack_into('<I', e, 28, length)
+    return e
+
+mbr = bytearray(512)
+mbr[446] = 0 if a.inactive else 0x80
+mbr[446 + 4] = 0x0c
+struct.pack_into('<II', mbr, 446 + 8, START, TOTAL)
+mbr[510:512] = b'\x55\xaa' if not a.bad_mbr else b'\0\0'
+
+bpb = bytearray(512)
+bpb[0:3] = b'\xeb\x58\x90'
